# Local-only settings. Does not touch Supabase.
# Start FE + API + Postgres: docker compose --env-file .env.local up --build
# FE uses IdentityServer-FE/.env.docker (API_TARGET=http://api:8080).
# Run a built API image against that Postgres:
#   docker run --env-file .env.local --network libraryservice-local -p 8080:8080 library-api

ASPNETCORE_ENVIRONMENT=Local
ASPNETCORE_HTTP_PORTS=8080

POSTGRES_USER=library
POSTGRES_PASSWORD=library
POSTGRES_DB=libraryservice

# Host=postgres is the Compose service name on network libraryservice-local.
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=libraryservice;Username=library;Password=library
