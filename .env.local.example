# Copy to .env.local. That file is gitignored.
# Used by: launch profile "HackerRank1.API (Local)" / ASPNETCORE_ENVIRONMENT=Local
# Host=localhost reaches the published Postgres port from infrastructure compose.

ASPNETCORE_ENVIRONMENT=Local
ASPNETCORE_HTTP_PORTS=8080

POSTGRES_USER=library
POSTGRES_PASSWORD=library
POSTGRES_DB=libraryservice

CONNECTION_STRING=Host=localhost;Port=5432;Database=libraryservice;Username=library;Password=library
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=libraryservice;Username=library;Password=library
